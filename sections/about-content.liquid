{{ 'component-about-content.css' | asset_url | stylesheet_tag }}

<section class="about-content section">
  <div class="container">
    <div class="about-content__header text-center">
      <h1 class="about-content__title">
        {{ section.settings.title | default: 'About Us' }}
      </h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="about-content__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.image != blank -%}
      <div class="about-content__image">
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          alt="{{ section.settings.image.alt | escape }}"
          width="1200"
          height="auto"
          loading="lazy"
        >
      </div>
    {%- endif -%}

    <div class="about-content__body">
      {%- if section.settings.content != blank -%}
        {{ section.settings.content }}
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="about-content__values grid grid--3">
        {%- for block in section.blocks -%}
          {%- if block.type == 'value' -%}
            <div class="about-content__value card" {{ block.shopify_attributes }}>
              <h3 class="about-content__value-title">{{ block.settings.title }}</h3>
              <p class="about-content__value-text">{{ block.settings.text }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "About Content",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "About Smokey"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Your trusted source for premium smoking accessories"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Header Image"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Founded with a passion for quality and style, Smokey brings together the finest smoking accessories and lifestyle products for the modern enthusiast.</p>"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Quality First"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "We only offer products that meet our high standards"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Content",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "title": "Quality First",
            "text": "We only offer products that meet our high standards"
          }
        },
        {
          "type": "value",
          "settings": {
            "title": "Customer Focus",
            "text": "Your satisfaction is our top priority"
          }
        },
        {
          "type": "value",
          "settings": {
            "title": "Community",
            "text": "Building connections with like-minded individuals"
          }
        }
      ]
    }
  ]
}
{% endschema %}
