{{ 'component-customer.css' | asset_url | stylesheet_tag }}

<section class="customer-account section">
  <div class="container">
    <h1 class="customer-account__title">{{ 'customer.account.title' | t }}</h1>

    <div class="customer-account__content">
      <div class="customer-account__info card">
        <h2>{{ 'customer.account.details' | t }}</h2>
        <p><strong>{{ customer.name }}</strong></p>
        <p>{{ customer.email }}</p>
        <a href="{{ routes.account_logout_url }}" class="btn btn--secondary">
          {{ 'customer.account.logout' | t }}
        </a>
      </div>

      <div class="customer-account__orders card">
        <h2>{{ 'customer.orders.title' | t }}</h2>
        
        {% if customer.orders.size > 0 %}
          <div class="customer-orders">
            {% for order in customer.orders %}
              <div class="customer-order">
                <div class="customer-order__header">
                  <h3>{{ 'customer.orders.order_number' | t }}: {{ order.name }}</h3>
                  <span>{{ order.created_at | date: "%B %d, %Y" }}</span>
                </div>
                <div class="customer-order__details">
                  <span>{{ 'customer.orders.total' | t }}: {{ order.total_price | money }}</span>
                  <a href="{{ order.customer_url }}" class="btn btn--outline">View Order</a>
                </div>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <p>{{ 'customer.orders.none' | t }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Account",
  "settings": []
}
{% endschema %}
