{{ 'component-customer.css' | asset_url | stylesheet_tag }}

<section class="customer-login section">
  <div class="container">
    <div class="customer-login__inner">
      <div class="customer-login__form card">
        <h1 class="customer-login__title">{{ 'customer.login.title' | t }}</h1>

        {% form 'customer_login' %}
          {{ form.errors | default_errors }}

          <div class="customer-login__field">
            <label for="CustomerEmail">{{ 'customer.login.email' | t }}</label>
            <input
              type="email"
              name="customer[email]"
              id="CustomerEmail"
              autocomplete="email"
              required
            >
          </div>

          <div class="customer-login__field">
            <label for="CustomerPassword">{{ 'customer.login.password' | t }}</label>
            <input
              type="password"
              name="customer[password]"
              id="CustomerPassword"
              required
            >
          </div>

          <div class="customer-login__actions">
            <button type="submit" class="btn btn--primary btn--large btn--full">
              {{ 'customer.login.sign_in' | t }}
            </button>
            
            <a href="{{ routes.account_recover_url }}" class="customer-login__recover">
              {{ 'customer.login.forgot_password' | t }}
            </a>
          </div>
        {% endform %}

        <div class="customer-login__create">
          <p>{{ 'customer.login.new_customer' | t }}</p>
          <a href="{{ routes.account_register_url }}" class="btn btn--outline btn--full">
            {{ 'customer.login.create_account' | t }}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Login",
  "settings": []
}
{% endschema %}
