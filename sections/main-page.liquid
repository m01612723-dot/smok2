{{ 'component-main-page.css' | asset_url | stylesheet_tag }}

<section class="main-page section">
  <div class="container">
    <div class="main-page__inner">
      <h1 class="main-page__title">{{ page.title }}</h1>
      
      {%- if page.content != blank -%}
        <div class="main-page__content">
          {{ page.content }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}
