{{ 'component-main-cart.css' | asset_url | stylesheet_tag }}

<section class="main-cart section">
  <div class="container">
    <h1 class="main-cart__title">{{ 'general.cart.title' | t }}</h1>

    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" class="main-cart__form">
        <div class="main-cart__items">
          {%- for item in cart.items -%}
            <div class="cart-item">
              <div class="cart-item__image">
                {%- if item.image -%}
                  <img
                    src="{{ item.image | image_url: width: 150 }}"
                    alt="{{ item.image.alt | escape }}"
                    width="150"
                    height="150"
                  >
                {%- endif -%}
              </div>

              <div class="cart-item__details">
                <h3 class="cart-item__title">{{ item.product.title }}</h3>
                {%- if item.variant.title != 'Default Title' -%}
                  <p class="cart-item__variant">{{ item.variant.title }}</p>
                {%- endif -%}
                <p class="cart-item__price">{{ item.final_price | money }}</p>
              </div>

              <div class="cart-item__quantity">
                <input
                  type="number"
                  name="updates[]"
                  value="{{ item.quantity }}"
                  min="0"
                  data-line="{{ forloop.index }}"
                  class="cart-item__quantity-input"
                >
              </div>

              <div class="cart-item__total">
                {{ item.final_line_price | money }}
              </div>

              <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="cart-item__remove">
                {{ 'general.cart.remove' | t }}
              </a>
            </div>
          {%- endfor -%}
        </div>

        <div class="main-cart__footer">
          <div class="main-cart__subtotal">
            <span>{{ 'general.cart.subtotal' | t }}</span>
            <span class="main-cart__subtotal-price">{{ cart.total_price | money }}</span>
          </div>

          <p class="main-cart__note">{{ 'general.cart.taxes_and_shipping' | t }}</p>

          <button type="submit" name="update" class="btn btn--secondary btn--full">
            {{ 'general.cart.update' | t }}
          </button>

          <button type="submit" name="checkout" class="btn btn--primary btn--large btn--full">
            {{ 'general.cart.checkout' | t }}
          </button>

          <a href="{{ routes.all_products_collection_url }}" class="main-cart__continue">
            {{ 'general.cart.continue_shopping' | t }}
          </a>
        </div>
      </form>
    {% else %}
      <div class="main-cart__empty">
        <p>{{ 'general.cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary btn--large">
          {{ 'general.cart.continue_shopping' | t }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
