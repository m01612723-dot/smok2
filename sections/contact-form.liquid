{{ 'component-contact-form.css' | asset_url | stylesheet_tag }}

<section class="contact-form section">
  <div class="container">
    <div class="contact-form__inner">
      <div class="contact-form__content">
        <h2 class="contact-form__title">
          {{ section.settings.title | default: 'contact.form.title' | t }}
        </h2>
        
        {%- if section.settings.description != blank -%}
          <div class="contact-form__description">
            {{ section.settings.description }}
          </div>
        {%- endif -%}

        {%- if section.settings.show_info -%}
          <div class="contact-form__info">
            {%- if section.settings.email != blank -%}
              <div class="contact-form__info-item">
                <strong>Email:</strong> 
                <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
              </div>
            {%- endif -%}
            
            {%- if section.settings.phone != blank -%}
              <div class="contact-form__info-item">
                <strong>Phone:</strong> 
                <a href="tel:{{ section.settings.phone }}">{{ section.settings.phone }}</a>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="contact-form__form-wrapper">
        {% form 'contact' %}
          {%- if form.posted_successfully? -%}
            <div class="contact-form__message contact-form__message--success">
              {{ 'contact.form.success' | t }}
            </div>
          {%- endif -%}

          {{ form.errors | default_errors }}

          <div class="contact-form__field">
            <label for="contact-name">{{ 'contact.form.name' | t }}</label>
            <input
              type="text"
              id="contact-name"
              name="contact[name]"
              required
            >
          </div>

          <div class="contact-form__field">
            <label for="contact-email">{{ 'contact.form.email' | t }}</label>
            <input
              type="email"
              id="contact-email"
              name="contact[email]"
              required
            >
          </div>

          <div class="contact-form__field">
            <label for="contact-phone">{{ 'contact.form.phone' | t }}</label>
            <input
              type="tel"
              id="contact-phone"
              name="contact[phone]"
            >
          </div>

          <div class="contact-form__field">
            <label for="contact-message">{{ 'contact.form.message' | t }}</label>
            <textarea
              id="contact-message"
              name="contact[message]"
              required
            ></textarea>
          </div>

          <button type="submit" class="btn btn--primary btn--large btn--full">
            {{ 'contact.form.submit' | t }}
          </button>
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact Form",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Contact Us"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Get in touch with us. We'd love to hear from you!</p>"
    },
    {
      "type": "checkbox",
      "id": "show_info",
      "label": "Show Contact Information",
      "default": true
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "hello@smokey.com"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "+49 123 456 7890"
    }
  ],
  "presets": [
    {
      "name": "Contact Form"
    }
  ]
}
{% endschema %}
