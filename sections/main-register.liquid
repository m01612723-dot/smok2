{{ 'component-customer.css' | asset_url | stylesheet_tag }}

<section class="customer-register section">
  <div class="container">
    <div class="customer-register__inner">
      <div class="customer-register__form card">
        <h1 class="customer-register__title">{{ 'customer.register.title' | t }}</h1>

        {% form 'create_customer' %}
          {{ form.errors | default_errors }}

          <div class="customer-register__field">
            <label for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
            <input
              type="text"
              name="customer[first_name]"
              id="RegisterFirstName"
              required
            >
          </div>

          <div class="customer-register__field">
            <label for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
            <input
              type="text"
              name="customer[last_name]"
              id="RegisterLastName"
              required
            >
          </div>

          <div class="customer-register__field">
            <label for="RegisterEmail">{{ 'customer.register.email' | t }}</label>
            <input
              type="email"
              name="customer[email]"
              id="RegisterEmail"
              autocomplete="email"
              required
            >
          </div>

          <div class="customer-register__field">
            <label for="RegisterPassword">{{ 'customer.register.password' | t }}</label>
            <input
              type="password"
              name="customer[password]"
              id="RegisterPassword"
              required
            >
          </div>

          <button type="submit" class="btn btn--primary btn--large btn--full">
            {{ 'customer.register.submit' | t }}
          </button>
        {% endform %}

        <div class="customer-register__login">
          <p>Already have an account?</p>
          <a href="{{ routes.account_login_url }}" class="btn btn--outline btn--full">
            {{ 'customer.login.sign_in' | t }}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Register",
  "settings": []
}
{% endschema %}
