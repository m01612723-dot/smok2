[
  {
    "name": "theme_info",
    "theme_name": "Smokey",
    "theme_version": "1.0.0",
    "theme_author": "Smokey Brand",
    "theme_documentation_url": "",
    "theme_support_url": ""
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Brand Colors"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary Color (Neon Green)",
        "default": "#39FF14"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background Color",
        "default": "#0D0D0D"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface Color",
        "default": "#1A1A1A"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text Color",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "label": "Muted Text Color",
        "default": "#9CA3AF"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Font Settings"
      },
      {
        "type": "font_picker",
        "id": "type_header_font",
        "default": "assistant_n4",
        "label": "Heading Font",
        "info": "Font used for headings"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "assistant_n4",
        "label": "Body Font",
        "info": "Font used for body text"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "header",
        "content": "Layout Settings"
      },
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 100,
        "default": 1280,
        "unit": "px",
        "label": "Page Width"
      },
      {
        "type": "range",
        "id": "spacing_sections",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Section Spacing",
        "default": 64
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "header",
        "content": "Cart Settings"
      },
      {
        "type": "select",
        "id": "cart_type",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer"
          },
          {
            "value": "page",
            "label": "Page"
          }
        ],
        "default": "drawer",
        "label": "Cart Type"
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "header",
        "content": "Social Media Links"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook",
        "info": "https://facebook.com/yourstore"
      },
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram",
        "info": "https://instagram.com/yourstore"
      },
      {
        "type": "text",
        "id": "social_twitter_link",
        "label": "Twitter",
        "info": "https://twitter.com/yourstore"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube",
        "info": "https://youtube.com/yourstore"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok",
        "info": "https://tiktok.com/@yourstore"
      }
    ]
  },
  {
    "name": "Age Verification",
    "settings": [
      {
        "type": "header",
        "content": "Age Verification (18+)"
      },
      {
        "type": "checkbox",
        "id": "age_verification_enabled",
        "label": "Enable Age Verification",
        "default": true
      },
      {
        "type": "text",
        "id": "age_verification_title",
        "label": "Title",
        "default": "Age Verification"
      },
      {
        "type": "textarea",
        "id": "age_verification_message",
        "label": "Message",
        "default": "You must be 18 years or older to access this website. Please confirm your age to continue."
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  }
]
