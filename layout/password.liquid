<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#0D0D0D">
    <meta name="robots" content="noindex">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | img_url: '32x32' }}">
    {%- endif -%}

    <title>{{ shop.name }}</title>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    
    {{ content_for_header }}

    <style>
      .password-page {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 2rem;
        text-align: center;
      }

      .password-page__logo {
        margin-bottom: 2rem;
        max-width: 200px;
      }

      .password-page__content {
        max-width: 500px;
        width: 100%;
      }

      .password-page__title {
        margin-bottom: 1rem;
        color: var(--color-primary);
      }

      .password-page__message {
        margin-bottom: 2rem;
        color: var(--color-text-muted);
      }

      .password-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 2rem;
      }

      .password-form__input-group {
        display: flex;
        gap: 0.5rem;
      }

      .password-form__input {
        flex: 1;
      }

      .password-footer {
        padding-top: 2rem;
        border-top: 1px solid var(--color-border);
        color: var(--color-text-muted);
        font-size: 0.875rem;
      }
    </style>
  </head>

  <body class="password">
    <div class="password-page">
      {% if shop.logo %}
        <img class="password-page__logo" src="{{ shop.logo | img_url: '200x' }}" alt="{{ shop.name }}">
      {% endif %}

      <div class="password-page__content">
        <h1 class="password-page__title">{{ 'general.password_page.opening_soon' | t }}</h1>
        
        {% if shop.password_message != blank %}
          <div class="password-page__message">
            {{ shop.password_message }}
          </div>
        {% else %}
          <p class="password-page__message">
            {{ 'general.password_page.spread_the_word' | t }}
          </p>
        {% endif %}

        {% form 'storefront_password', class: 'password-form' %}
          {{ form.errors | default_errors }}
          
          <div class="password-form__input-group">
            <input
              type="password"
              name="password"
              id="Password"
              class="password-form__input"
              placeholder="{{ 'general.password_page.password' | t }}"
              autofocus
            >
            <button type="submit" class="btn btn--primary">
              {{ 'general.password_page.enter' | t }}
            </button>
          </div>
        {% endform %}

        {% if shop.password_message != blank %}
          <small class="password-footer">
            {{ 'general.password_page.admin_link_html' | t }}
          </small>
        {% endif %}
      </div>
    </div>
  </body>
</html>
